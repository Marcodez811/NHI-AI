      "cardMode": "single",
      "viewport": "720x480"
    },
    "ChatMessageList": {
      "cardMode": "column"
    },
    "AlertDialog": {
      "cardMode": "single",
      "viewport": "720x420"
    },
    "ConfirmDialog": {
      "cardMode": "single",
      "viewport": "720x420"
    },
    "DropdownMenu": {
      "cardMode": "single",
