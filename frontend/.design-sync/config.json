{
  "projectId": "8ff266f8-e575-4269-8e31-68f6a3b604a7",
  "shape": "package",
  "pkg": "nhi-ai-ui",
  "globalName": "NhiAiUi",
  "buildCmd": "node .design-sync/build.mjs",
