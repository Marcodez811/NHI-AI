# Required provider and queue settings
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GEMINI_API_KEY=replace-me
# Agent execution models. Authors/revisions use the cost-sensitive model;
# semantic reviewers use the stronger model by default.
AGENT_DEFAULT_MODEL=gpt-5.6-luna
AGENT_AUTHOR_MODEL=gpt-5.6-luna
AGENT_REVIEWER_MODEL=gpt-5.6-sol
AGENT_DEFAULT_REASONING_EFFORT=high
AGENT_AUTHOR_REASONING_EFFORT=high
AGENT_REVIEWER_REASONING_EFFORT=high
# Deprecated fallback accepted for AGENT_DEFAULT_MODEL:
# OPENAI_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.6-luna
CHAT_STREAM_HEARTBEAT_SECONDS=10
CHAT_TIMEOUT_SECONDS=180

# Optional first-run seed. When omitted, the backend creates and persists an
# empty news-free store in the database during startup.
# OPENAI_VECTOR_STORE_ID=vs_replace_me
OPENAI_VECTOR_STORE_BOOTSTRAP_TIMEOUT_SECONDS=10

# Dedicated Redis Streams and Taskiq worker limits
DOCUMENTS_QUEUE_NAME=documents
TASKS_QUEUE_NAME=tasks
DOCUMENTS_WORKER_PROCESSES=1
DOCUMENTS_WORKER_MAX_ASYNC_TASKS=4
TASKS_WORKER_PROCESSES=2
TASKS_WORKER_MAX_ASYNC_TASKS=2
DOCUMENT_CLEANUP_LEASE_SECONDS=300
DOCUMENT_CLEANUP_RETRY_BASE_SECONDS=60
DOCUMENT_CLEANUP_RETRY_MAX_SECONDS=3600
DOCUMENT_CLEANUP_RECONCILE_INTERVAL_SECONDS=900
DOCUMENT_CLEANUP_RECONCILE_BATCH_SIZE=100
TASKIQ_SCHEDULE_PREFIX=nhi-ai

# Local development defaults to SQLite; Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./nhi_ai.db
DOCUMENTS_ROOT=/tmp/documents
AGENT_JOBS_ROOT=/tmp/agents/jobs
AGENT_OUTPUT_ROOT=/tmp/agents/output
AGENT_TIMEOUT_MINUTES=60
AGENT_HEARTBEAT_SECONDS=10
AGENT_KEEP_WORKSPACE_ON_FAILURE=true
AGENT_MAX_AUTHOR_ATTEMPTS=5
AGENT_REVIEW_STAGNATION_LIMIT=2
# Development-only, unauthenticated agent telemetry. Keep disabled unless the
# service is reachable only through a trusted local network.
ENABLE_AGENT_DEV_ROUTES=false
AGENT_EVENT_RETENTION_SECONDS=86400

# Deprecated aliases (use the DOCUMENTS_*/AGENT_* names above).
# SLIDES_JOBS_ROOT=/tmp/slides/jobs
# SLIDES_DOCUMENTS_ROOT=/tmp/slides/documents
# SLIDES_OUTPUT_ROOT=/tmp/slides/output
# SLIDES_TIMEOUT_MINUTES=45
# SLIDES_KEEP_WORKSPACE_ON_FAILURE=true
