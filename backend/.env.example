# Secrets and deployment values only. Product behaviour (models, limits, timeouts)
# lives in config.yaml; any YAML-backed value can still be overridden here by env.

# Provider API keys. OpenAI is required; Anthropic/Gemini enable their models.
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Connections: Redis (queues/broker) and the application database.
REDIS_URL=redis://redis:6379/0
# Local development defaults to SQLite; Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./nhi_ai.db

# Filesystem roots for uploaded documents, agent workspaces and agent outputs.
DOCUMENTS_ROOT=/tmp/documents
AGENT_JOBS_ROOT=/tmp/agents/jobs
AGENT_OUTPUT_ROOT=/tmp/agents/output

# Dedicated Redis Streams queues and Taskiq worker limits.
DOCUMENTS_QUEUE_NAME=documents
TASKS_QUEUE_NAME=tasks
DOCUMENTS_WORKER_PROCESSES=1
DOCUMENTS_WORKER_MAX_ASYNC_TASKS=4
TASKS_WORKER_PROCESSES=2
TASKS_WORKER_MAX_ASYNC_TASKS=2
TASKIQ_SCHEDULE_PREFIX=nhi-ai

# Development-only, unauthenticated agent telemetry. Keep disabled unless the
# service is reachable only through a trusted local network.
ENABLE_AGENT_DEV_ROUTES=false
# Show developer-only settings on the settings page (reserved for the settings UI).
ENABLE_DEV_SETTINGS=false

# Optional first-run seed. When omitted, the backend creates and persists an
# empty news-free store in the database during startup.
# OPENAI_VECTOR_STORE_ID=vs_replace_me
