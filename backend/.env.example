# Required provider and queue settings
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Use a dedicated vector store that contains no news sources.
OPENAI_VECTOR_STORE_ID=vs_replace_me

# Dedicated Redis Streams and Taskiq worker limits
DOCUMENTS_QUEUE_NAME=documents
TASKS_QUEUE_NAME=tasks
DOCUMENTS_WORKER_PROCESSES=1
DOCUMENTS_WORKER_MAX_ASYNC_TASKS=4
TASKS_WORKER_PROCESSES=2
TASKS_WORKER_MAX_ASYNC_TASKS=2

# Local development defaults to SQLite; Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./nhi_ai.db
DOCUMENTS_ROOT=/tmp/documents
AGENT_JOBS_ROOT=/tmp/agents/jobs
AGENT_OUTPUT_ROOT=/tmp/agents/output
AGENT_TIMEOUT_MINUTES=45
AGENT_KEEP_WORKSPACE_ON_FAILURE=true
AGENT_MAX_REVIEW_ROUNDS=3

# Deprecated aliases (use the DOCUMENTS_*/AGENT_* names above).
# SLIDES_JOBS_ROOT=/tmp/slides/jobs
# SLIDES_DOCUMENTS_ROOT=/tmp/slides/documents
# SLIDES_OUTPUT_ROOT=/tmp/slides/output
# SLIDES_TIMEOUT_MINUTES=45
# SLIDES_KEEP_WORKSPACE_ON_FAILURE=true
