{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceMap v1",
  "type": "object",
  "required": ["format_version", "source_manifest", "claims"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": "EvidenceMap v1"},
    "source_manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "slide_number", "claim", "claim_type", "sources"],
        "additionalProperties": false,
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "slide_number": {"type": "integer", "minimum": 1},
          "claim": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["source_fact", "derived_calculation", "interpretation"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_id", "block_id"],
              "additionalProperties": false,
              "properties": {
                "document_id": {"type": "string", "minLength": 1},
                "block_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
